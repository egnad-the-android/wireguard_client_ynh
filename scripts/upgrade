#!/bin/bash
# shellcheck disable=SC2154
# app and install_dir are set by the YunoHost helpers.

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# Do not copy the live /etc/yunohost/apps/$app/config_panel.toml over the
# package copy. That hid new panel pages (including The Gate page) on upgrade.
# Rebuild the live panel from the current template plus any extra interfaces.
compy_ensure_settings
compy_install_files
compy_ensure_ssh_key
compy_secure_conf_files
compy_regen_config_panel

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

# Create dedicated systemd configs for starting and monitoring WireGuard's configurations
ynh_config_add --template="wireguard_client@.service" --destination="/etc/systemd/system/$app@.service"
systemctl daemon-reload

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
ynh_print_info "The Gate: if the tunnel is already up, open The Gate page and click Re-sync ports so the VPS applies the ICMP ping fix. The live tunnel config is not rewritten. If an old action log is stuck, run: sudo systemctl restart yunohost-api"
