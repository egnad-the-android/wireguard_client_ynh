#!/bin/bash
# shellcheck disable=SC2154
# app and install_dir are set by the YunoHost helpers.

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# Needed for the config panel
ynh_app_setting_set --key=interfaces --value=""

# Compy Public access panel defaults, SSH key, and shipped scripts
compy_ensure_settings
compy_install_files
compy_ensure_ssh_key

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create dedicated systemd configs for starting and monitoring WireGuard's configurations
ynh_config_add --template="wireguard_client@.service" --destination="/etc/systemd/system/$app@.service"
systemctl daemon-reload

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed. Open the Public access (Compy) page to connect a VPS, or the Advanced interfaces page to upload a WireGuard client config."
