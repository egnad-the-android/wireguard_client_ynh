#!/bin/bash
# shellcheck disable=SC2154
# app and install_dir are set by the YunoHost helpers.

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REMOVE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Removing system configurations related to $app..."

# Remove the services from the list of services known by Yunohost (added from `yunohost service add`)
# Includes the Compy tunnel (compy.conf) if it was set up.
shopt -s nullglob
for file in "$install_dir"/*.conf ; do
    i="$(basename "$file" .conf)"
    systemctl disable --quiet --now "wireguard_client@$i.service" || true
    yunohost service remove "wireguard_client@$i" || true
done
shopt -u nullglob

systemctl disable --now compy-watchdog.timer 2>/dev/null || true
systemctl stop compy-watchdog.service 2>/dev/null || true
ynh_safe_rm "/etc/systemd/system/compy-watchdog.timer"
ynh_safe_rm "/etc/systemd/system/compy-watchdog.service"
ynh_safe_rm "/etc/systemd/system/wireguard_client@.service"
systemctl daemon-reload || true

# The VPS is not torn down automatically (no surprise remote changes on
# app removal). To uninstall the gateway, run vps_setup.sh with --uninstall
# on the VPS while you still have SSH access.
ynh_print_info "This app was removed from YunoHost. If a Compy VPS was set up, it was left as-is. To tear it down, run the setup script on the VPS with --uninstall."

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"
